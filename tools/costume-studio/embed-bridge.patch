+++ b/src/lib/embed-bridge.js
@@ -0,0 +1,44 @@
+/*
+ * Embed bridge: lets a parent page that embeds Costume Studio in an <iframe>
+ * hand it an SVG to edit and read the edited SVG back. Added by scratch-TWC.
+ * Only messages sent by window.parent are accepted.
+ *
+ *   parent -> studio  {target: 'costume-studio', type: 'open', svg, name}
+ *   parent -> studio  {target: 'costume-studio', type: 'get', id}
+ *   studio -> parent  {source: 'costume-studio', type: 'ready'}
+ *   studio -> parent  {source: 'costume-studio', type: 'svg', id, svg}
+ */
+export const isEmbedded = () => {
+    try {
+        return window.parent && window.parent !== window;
+    } catch (error) {
+        return false;
+    }
+};
+
+export const installEmbedBridge = ({getSvg, openSvg, openBlank}) => {
+    if (!isEmbedded()) return () => {};
+    const handler = event => {
+        if (event.source !== window.parent) return;
+        const data = event.data;
+        if (!data || data.target !== 'costume-studio') return;
+        if (data.type === 'open') {
+            if (typeof data.svg === 'string' && data.svg.trim()) openSvg(data.svg, data.name);
+            else openBlank();
+        } else if (data.type === 'get') {
+            // Let the paint editor finish committing the last stroke first.
+            window.setTimeout(() => {
+                let svg = '';
+                try {
+                    svg = getSvg() || '';
+                } catch (error) {
+                    svg = '';
+                }
+                window.parent.postMessage({source: 'costume-studio', type: 'svg', id: data.id, svg}, event.origin || '*');
+            }, 150);
+        }
+    };
+    window.addEventListener('message', handler);
+    window.parent.postMessage({source: 'costume-studio', type: 'ready'}, '*');
+    return () => window.removeEventListener('message', handler);
+};
